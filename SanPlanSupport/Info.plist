<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>ru</string>
    <key>CFBundleDisplayName</key>
    <string>ARNA</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>ARNA</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.sanplan.companion.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>arna</string>
            </array>
        </dict>
    </array>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>26.0</string>
    <key>NSAlarmKitUsageDescription</key>
    <string>ARNA ставит системные будильники для планов и конца отдыха на тренировке.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>ARNA записывает в «Здоровье» тренировки из истории: время, длительность и вид.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>ARNA проверяет в «Здоровье» тренировки, которые записала сама, чтобы обновлять и удалять их вместе с историей.</string>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Речь распознаётся на iPhone, чтобы вводить планы и расходы голосом.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Микрофон нужен для голосового ввода планов и расходов.</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
